# Copy to .env (cp .env.example .env). All optional: with no .env the app runs
# single-user/local with no AI. docker-compose.yml reads these as ${VAR:-}.

# --- Access control ---
# Password for login (signed session cookie). Empty = single-user local, no login.
ANSIBLE_GUI_PASSWORD=

# Credential encryption key (Fernet, url-safe base64, 32 bytes). Empty = generated
# to /data/master.key on first start. Set it to keep the key off the data volume.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ANSIBLE_GUI_MASTER_KEY=

# --- AI helper (optional; also editable at runtime in Settings) ---
ANTHROPIC_API_KEY=

# OpenAI or any OpenAI-compatible endpoint (base URL set in the UI).
OPENAI_API_KEY=

# Local Ollama, e.g. http://host.docker.internal:11434. Empty = Ollama off.
OLLAMA_URL=
OLLAMA_MODEL=
