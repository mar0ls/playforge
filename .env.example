# Copy to .env (cp .env.example .env). All optional: with no .env the app runs
# single-user/local with no AI. docker-compose.yml reads these as ${VAR:-}.

# --- Access control ---
# Password for login (signed session cookie). Empty = single-user local, no login.
ANSIBLE_GUI_PASSWORD=

# Credential encryption key (Fernet, url-safe base64, 32 bytes). Empty = generated
# to /data/master.key on first start. Set it to keep the key off the data volume.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ANSIBLE_GUI_MASTER_KEY=

# --- Run isolation (optional) ---
# Off by default. When on, playbooks run in a sandbox instead of directly on the
# app host, so a run can't reach /data (master.key, app.db, other projects).
# Whether it works depends on your host allowing unprivileged user namespaces —
# test it before relying on it. "1" to enable.
ANSIBLE_GUI_RUN_ISOLATION=
# bwrap (default, no container engine needed) or docker/podman. The container
# engines need their socket mounted into this container, which grants
# root-equivalent access to the host — a worse trade than it looks.
ANSIBLE_GUI_RUN_ISOLATION_EXECUTABLE=
# Only used by docker/podman: the execution-environment image for the run.
ANSIBLE_GUI_RUN_ISOLATION_IMAGE=

# --- AI helper (optional; also editable at runtime in Settings) ---
ANTHROPIC_API_KEY=

# OpenAI or any OpenAI-compatible endpoint (base URL set in the UI).
OPENAI_API_KEY=

# Local Ollama, e.g. http://host.docker.internal:11434. Empty = Ollama off.
OLLAMA_URL=
OLLAMA_MODEL=
